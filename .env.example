# Config do projeto Firebase (Configurações do projeto → Seus apps → Web).
# Não são segredos — a segurança fica nas regras do Firestore (firestore.rules),
# não em esconder esses valores. Copie este arquivo para ".env" e preencha.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
